PORT=5000
NODE_ENV=development

# Required — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# DynamoDB Local (Docker)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
# Optional extra secret for OTP hashing (defaults to JWT_SECRET)
# OTP_PEPPER=
# true = log OTP in server console only | false = send via WhatsApp (requires credentials below)
# Auto-enabled when WHATSAPP_ACCESS_TOKEN is empty
OTP_DEV_MODE=true

# Meta WhatsApp Cloud API (customer login/signup OTP)
# Setup guide: docs/WHATSAPP_SETUP.md
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=oraya_otp
# authentication = Meta OTP template with copy-code button | utility = body-only {{1}}
WHATSAPP_TEMPLATE_TYPE=authentication
WHATSAPP_LANGUAGE_CODE=en

# One-time admin seed (npm run db:seed)
ADMIN_SEED_EMAIL=admin@orayabeauty.in
ADMIN_SEED_PASSWORD=
